# Copy to .env.local and fill in. Never commit .env.local.

# true = every lane returns mock data, so the app runs before anything is wired up
USE_MOCKS=true
NEXT_PUBLIC_DEMO_CASE_ID=demo-2041
# Public URL the mini app cards and ElevenLabs tools call (Vercel URL or an ngrok tunnel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Teammate 3 (AI + agents)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Z (Photon + backend)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
REVIEWER_PHONE=
MANAGER_PHONE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Voice (Z sets up the number, Teammate 3 owns the agent)
# Note: a shared iMessage line can't take calls; voice needs an SMS or dedicated Photon number.
PHOTON_VOICE_PROFILE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
