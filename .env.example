# Copy to .env.local and fill in. Never commit .env.local.

# true = every lane returns mock data, so the app runs before anything is wired up
USE_MOCKS=true
# Public HTTPS URL (Vercel or ngrok). Record links and ElevenLabs tool URLs are built from this.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Your own phone, to receive the demo record text. The demo worker calls from this number.
DEMO_WORKER_PHONE=

# Sunny (AI + voice agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=

# Zohaib (Photon + backend + voice number)
# Photon 2.0 (app.beta.photon.codes). API key needs project:read + project:write.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# The Photon number workers call and the record is texted from (E.164)
PHOTON_NUMBER=
# Only if texts go out from a different line than PHOTON_NUMBER
PHOTON_AGENT_HANDLE=
# imessage (default) or sms
PHOTON_TEXT_PLATFORM=
# whsec_... signing secret of the webhook destination pointing at /api/webhooks/photon
PHOTON_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Voice: Zohaib points the Photon number at the agent over SIP; Sunny owns the agent config.
# A shared iMessage line can't take calls; voice needs a dedicated Photon number.
PHOTON_VOICE_PROFILE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret ElevenLabs sends on every server tool call (header x-boomer-secret). Empty = no check (local dev).
VOICE_TOOL_SECRET=
